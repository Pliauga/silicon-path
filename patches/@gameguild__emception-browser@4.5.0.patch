diff --git a/dist/vfs/lazy.js b/dist/vfs/lazy.js
index 9e42d7b557a7f125596e5260a6aeb21474d5460d..984ae9e431a268017b9bf2d81b68cd912db2b7bf 100644
--- a/dist/vfs/lazy.js
+++ b/dist/vfs/lazy.js
@@ -227,8 +227,18 @@ export class LazyFS {
             console.error(`${P}   loadBundle: HASH MISMATCH for "${bundleName}": expected ${bundle.hash.slice(0, 12)}..., got ${hash.slice(0, 12)}...`);
             throw new Error(`Bundle hash mismatch for ${bundleName}`);
         }
-        // Decompress if the URL ends with .br (brotli-compressed tar)
-        if (bundle.url.endsWith('.tar.br') || bundle.url.endsWith('.br')) {
+        // Decompress brotli payloads. The URL suffix alone is not reliable
+        // (static hosts may expose the same bytes under another name), so fall
+        // back to the tar magic at offset 257: an already-raw tar must not be
+        // decompressed twice.
+        const isTar =
+            data.length > 262 &&
+            data[257] === 0x75 && data[258] === 0x73 && data[259] === 0x74 &&
+            data[260] === 0x61 && data[261] === 0x72;
+        const brotliPayload =
+            !isTar &&
+            (bundle.url.endsWith('.tar.br') || bundle.url.endsWith('.br') || bundle.url.endsWith('.brotli'));
+        if (brotliPayload) {
             const tDecomp = performance.now();
             data = new Uint8Array(await this.decompressBrotli(data));
             console.log(`${P}   loadBundle: brotli decompressed ${fmtSize(rawSize)} → ${fmtSize(data.length)} in ${(performance.now() - tDecomp).toFixed(1)}ms`);
