{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// Off deliberately: the four vendored 3D studies (src/lib/components/viz/*3D.svelte,
		// CPUExplodedView.svelte) were written under a config without it and index into
		// geometry/process arrays in lockstep. Rewriting ~90 hot-path accesses to satisfy
		// the flag would edit polished art code for no runtime gain.
		"noUncheckedIndexedAccess": false,
		"moduleResolution": "bundler"
	}
}
